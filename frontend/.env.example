
# ==================================================
# PragyanAI - Video People Counting
# Frontend Environment Configuration
# ==================================================

# --------------------------------------------------
# BACKEND API URL
# --------------------------------------------------

# Local development
#VITE_API_BASE_URL=http://localhost:8000

# Production deployment:
# Set this value in Netlify Dashboard:
#
VITE_API_BASE_URL=https://pragyanai-video-people-counting-pytorch.onrender.com/


# --------------------------------------------------
# APPLICATION CONFIGURATION
# --------------------------------------------------

VITE_APP_NAME=PragyanAI Video People Counting

VITE_APP_VERSION=1.0.0

VITE_APP_ENV=production


# --------------------------------------------------
# VIDEO UPLOAD CONFIGURATION
# --------------------------------------------------

VITE_MAX_UPLOAD_SIZE=524288000

VITE_ALLOWED_VIDEO_FORMATS=mp4,avi,mov,mkv,webm


# --------------------------------------------------
# PROCESSING CONFIGURATION
# --------------------------------------------------

VITE_DEFAULT_CONFIDENCE=0.35

VITE_DEFAULT_FRAME_INTERVAL=1

VITE_STATUS_POLL_INTERVAL=3000
